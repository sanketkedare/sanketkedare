# ===================================================================
# sanketkedare-portfolio Environment Variables (www.sanketkedare.com)
# ===================================================================

# MongoDB Atlas (Same connection string as Admin Portal for live data sync)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sanketkedare?retryWrites=true&w=majority

# Canonical Base URL
NEXT_PUBLIC_APP_URL=https://www.sanketkedare.com

# EmailJS Configuration (For Public Contact Form)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=user_xxxxx

# Google Gemini API Key (For Public Visitor AI Assistant)
GEMINI_API_KEY=AIzaSy...
